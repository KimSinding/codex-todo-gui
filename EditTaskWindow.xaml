<Window x:Class="TodoList.EditTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit task" Width="400" Height="145" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBox Margin="12,12,12,8" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveCommand}" /></TextBox.InputBindings>
        </TextBox>
        <Button Grid.Row="1" Content="Save" Width="80" HorizontalAlignment="Right" Margin="0,0,12,12" IsDefault="True" Command="{Binding SaveCommand}" />
    </Grid>
</Window>
